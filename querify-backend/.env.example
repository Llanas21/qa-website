# ================= Querify Analytics — backend =================
# Copia este archivo a ".env" y llena los valores. Lo que dejes vacío
# se ejecuta en MODO SIMULACIÓN (no se envía nada real; se registra en la base).

# --- Servidor ---
PORT=3000
# Origen(es) del sitio que puede hacer POST al formulario (separados por coma).
# Si sirves el sitio desde este mismo backend, puedes dejarlo vacío.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
# Ruta a la carpeta del sitio estático para servirlo desde aquí (opcional).
# Si apuntas a la carpeta querify-web, el backend sirve el sitio + API + panel juntos.
STATIC_DIR=../querify-web

# --- Base de datos (PostgreSQL) ---
# En Railway/Render se genera automáticamente. En local, algo como:
DATABASE_URL=postgres://usuario:password@localhost:5432/querify

# --- Panel de administración (login simple, un solo usuario) ---
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
ADMIN_USER=admin
# Genera el hash con:  npm run hash -- "tu-contraseña"
ADMIN_PASS_HASH=

# --- WhatsApp (Meta Cloud API directa) ---
# Si están vacíos, los mensajes de WhatsApp se SIMULAN.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Token que TÚ inventas y registras en Meta para verificar el webhook:
WHATSAPP_VERIFY_TOKEN=querify-verify-2026
# Idioma de las plantillas dadas de alta en Meta:
WHATSAPP_TEMPLATE_LANG=es_MX
# Nombres de las 4 plantillas tal como las apruebes en Meta:
TPL_BIENVENIDA=querify_bienvenida
TPL_RECORDATORIO=querify_recordatorio
TPL_VALOR=querify_valor
TPL_CIERRE=querify_cierre

# --- Correo (respaldo, vía Microsoft Graph — buzón compartido) ---
# Se envía como este buzón usando la misma app de Graph de abajo
# (permiso de aplicación Mail.Send). Si GRAPH_* están vacíos, se SIMULA.
# Debe ser solo la dirección, sin "Nombre <...>" — el nombre para mostrar
# lo controla el propio buzón compartido en Microsoft 365.
MAIL_FROM=noreply@QuerifyAnalytics.onmicrosoft.com

# --- Microsoft Graph (correo + bitácora en Excel/SharePoint) ---
# App registrada en Entra ID. Permisos de aplicación: Mail.Send (correo) y
# Files.ReadWrite.All (bitácora, opcional), con consentimiento de administrador.
# Si tenant/client/secret están vacíos, correo se SIMULA y sync se OMITE.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Item (archivo .xlsx) y tabla donde se agregan las filas (solo si usas la bitácora):
GRAPH_DRIVE_ID=
GRAPH_WORKBOOK_ITEM_ID=
GRAPH_TABLE_NAME=Prospectos

# --- Secuencia de seguimiento (horas desde que inicia la secuencia) ---
# Reproduce la tabla del brief: recordatorio 24h, valor 72h, cierre 7 días.
SEQ_STEP1_HOURS=24
SEQ_STEP2_HOURS=72
SEQ_STEP3_HOURS=168
# Días para tratar a un prospecto repetido como "frío que volvió" (reinicia secuencia):
DEDUP_RESET_DAYS=14
# Cron del motor (por defecto cada hora):
CRON_SCHEDULE=0 * * * *
